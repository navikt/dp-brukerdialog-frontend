{
  "name": "dp-brukerdialog-frontend",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "eslint",
    "copy-env": "cp .env.example .env",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "token": "node ./scripts/token-generator.cjs",
    "oversetting-verify-commit": "node ./scripts/oversetting-verify-commit.cjs",
    "prepare": "husky",
    "test": "vitest --run",
    "coverage": "vitest run --coverage",
    "dependabot": "react-router typegen && tsc && vitest --run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install"
  },
  "dependencies": {
    "@elastic/ecs-pino-format": "1.5.0",
    "@grafana/faro-web-sdk": "2.11.0",
    "@grafana/faro-web-tracing": "2.11.0",
    "@navikt/aksel-icons": "8.16.1",
    "@navikt/ds-css": "8.16.1",
    "@navikt/ds-react": "8.16.1",
    "@navikt/nav-dekoratoren-moduler": "4.3.0",
    "@navikt/oasis": "4.1.4",
    "@portabletext/react": "8.0.1",
    "@portabletext/to-html": "^6.0.0",
    "@portabletext/types": "4.0.2",
    "@prometheus-io/client": "^0.16.1",
    "@react-router/fs-routes": "8.3.1",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "^8.3.1",
    "@remix-run/form-data-parser": "0.17.5",
    "@rvf/react-router": "8.2.0",
    "@rvf/zod": "7.0.5",
    "classnames": "2.5.1",
    "date-fns": "4.4.0",
    "html-react-parser": "6.1.7",
    "i18n-iso-countries": "7.14.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "isbot": "5.2.2",
    "msw": "2.15.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.12",
    "react-router": "8.3.1",
    "sanitize-html": "^2.17.7",
    "tiny-invariant": "1.3.3",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@inquirer/prompts": "8.7.0",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "autoprefixer": "10.5.4",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.11.0",
    "husky": "9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-devtools-json": "1.1.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,json,css}": [
      "prettier --write"
    ],
    "app/**/locales/*.json": [
      "node scripts/strip-trailing-newline.cjs"
    ],
    "i18n/**/*.json": [
      "node scripts/strip-trailing-newline.cjs"
    ]
  }
}
