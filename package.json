{
  "name": "dp-brukerdialog-frontend",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "eslint",
    "copy-env": "cp .env.example .env",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "token": "node ./scripts/token-generator.cjs",
    "oversetting-verify-commit": "node ./scripts/oversetting-verify-commit.cjs",
    "prepare": "husky",
    "test": "vitest --run",
    "coverage": "vitest run --coverage",
    "dependabot": "react-router typegen && tsc && vitest --run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install"
  },
  "dependencies": {
    "@elastic/ecs-pino-format": "1.5.0",
    "@grafana/faro-web-sdk": "2.12.1",
    "@grafana/faro-web-tracing": "2.12.1",
    "@navikt/aksel-icons": "8.18.0",
    "@navikt/ds-css": "8.18.0",
    "@navikt/ds-react": "8.18.0",
    "@navikt/nav-dekoratoren-moduler": "4.5.0",
    "@navikt/oasis": "4.2.2",
    "@react-router/fs-routes": "8.4.0",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "^8.4.0",
    "@remix-run/form-data-parser": "0.17.5",
    "@rvf/react-router": "8.2.0",
    "@rvf/zod": "7.0.5",
    "classnames": "2.5.1",
    "date-fns": "4.4.0",
    "html-react-parser": "6.1.8",
    "i18n-iso-countries": "7.14.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.2",
    "isbot": "5.2.2",
    "msw": "2.15.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^8.4.0",
    "sanitize-html": "^2.18.0",
    "tiny-invariant": "1.3.3",
    "uuid": "^14.0.2",
    "vite-plugin-devtools-json": "1.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@inquirer/prompts": "8.7.2",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "husky": "9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,json,css}": [
      "prettier --write"
    ],
    "app/**/locales/*.json": [
      "node scripts/strip-trailing-newline.cjs"
    ],
    "i18n/**/*.json": [
      "node scripts/strip-trailing-newline.cjs"
    ]
  }
}
