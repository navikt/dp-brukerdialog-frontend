{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "nb",
  "locales": ["nb", "en", "nn"],
  "sourceLanguageTag": "nb",
  "languageTags": ["nb", "en", "nn"],
  "modules": [
    "https://cdn.jsdelivr.net/npm/@inlang/plugin-i18next@latest/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/message-lint-rule-missing-translation@latest/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/message-lint-rule-empty-pattern@latest/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/message-lint-rule-without-source@latest/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/message-lint-rule-identical-pattern@latest/dist/index.js"
  ],
  "plugin.inlang.i18next": {
    "pathPattern": {
      "Søknadoversikt \n": "./app/seksjon/oversikt/locales/{languageTag}.json",
      "Personalia \n": "./app/seksjon/personalia/v1/locales/{languageTag}.json",
      "Din situasjon \n": "./app/seksjon/din-situasjon/v2/locales/{languageTag}.json",
      "Arbeidsforhold \n": "./app/seksjon/arbeidsforhold/v1/locales/{languageTag}.json",
      "Reell arbeidssøker \n": "./app/seksjon/reell-arbeidssøker/v1/locales/{languageTag}.json",
      "Utdanning \n": "./app/seksjon/utdanning/v1/locales/{languageTag}.json",
      "Verneplikt \n": "./app/seksjon/verneplikt/v1/locales/{languageTag}.json",
      "Egen næring \n": "./app/seksjon/egen-næring/v1/locales/{languageTag}.json",
      "Annen pengestøtte \n": "./app/seksjon/annen-pengestøtte/v1/locales/{languageTag}.json",
      "Barnetillegg \n": "./app/seksjon/barnetillegg/v1/locales/{languageTag}.json",
      "Dokumentasjon \n": "./app/seksjon/dokumentasjon/v1/locales/{languageTag}.json",
      "Tilleggsopplysninger \n": "./app/seksjon/tilleggsopplysninger/v1/locales/{languageTag}.json",
      "Oppsummering \n": "./app/seksjon/oppsummering/locales/{languageTag}.json",
      "Kvittering \n": "./app/seksjon/kvittering/locales/{languageTag}.json",
      "Ettersending \n": "./app/seksjon/ettersending/locales/{languageTag}.json",
      "Common": "./app/i18n/locales/{languageTag}.json"
    },
    "variableReferencePattern": ["{{", "}}"]
  },
  "messageLintRuleLevels": {
    "messageLintRule.inlang.missingTranslation": "error",
    "messageLintRule.inlang.emptyPattern": "error",
    "messageLintRule.inlang.messageWithoutSource": "warning",
    "messageLintRule.inlang.identicalPattern": "warning"
  }
}
