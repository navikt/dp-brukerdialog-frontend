{
  "$schema": "https://inlang.com/schema/project-settings",
  "sourceLanguageTag": "nb",
  "languageTags": ["nb", "en", "nn"],
  "modules": [
    "https://cdn.jsdelivr.net/npm/@inlang/plugin-i18next@latest/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/message-lint-rule-missing-translation@latest/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/message-lint-rule-empty-pattern@latest/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/message-lint-rule-without-source@latest/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/message-lint-rule-identical-pattern@latest/dist/index.js"
  ],
  "messageLintRuleLevels": {
    "messageLintRule.inlang.missingTranslation": "error",
    "messageLintRule.inlang.emptyPattern": "error",
    "messageLintRule.inlang.messageWithoutSource": "warning",
    "messageLintRule.inlang.identicalPattern": "warning"
  },
  "plugin.inlang.i18next": {
    "pathPattern": {
      "#Felles": "./app/i18n/locales/{languageTag}.json",
      "#Oversikt": "./app/seksjon/oversikt/locales/{languageTag}.json",
      "#Arbeidssøker": "./app/seksjon/arbeidssøker/locales/{languageTag}.json",
      "#Opprett søknad": "./app/seksjon/opprett-søknad/locales/{languageTag}.json",
      "#Personalia": "./app/seksjon/personalia/v1/locales/{languageTag}.json",
      "#Din situasjon": "./app/seksjon/din-situasjon/v1/locales/{languageTag}.json",
      "#Arbeidsforhold": "./app/seksjon/arbeidsforhold/v2/locales/{languageTag}.json",
      "#Annen pengestøtte": "./app/seksjon/annen-pengestøtte/v1/locales/{languageTag}.json",
      "#Egen næring": "./app/seksjon/egen-næring/v1/locales/{languageTag}.json",
      "#Verneplikt": "./app/seksjon/verneplikt/v1/locales/{languageTag}.json",
      "#Utdanning": "./app/seksjon/utdanning/v1/locales/{languageTag}.json",
      "#Barnetillegg": "./app/seksjon/barnetillegg/v1/locales/{languageTag}.json",
      "#Reell arbeidssøker": "./app/seksjon/reell-arbeidssøker/v1/locales/{languageTag}.json",
      "#Tilleggsopplysninger": "./app/seksjon/tilleggsopplysninger/v1/locales/{languageTag}.json",
      "#Dokumentasjon": "./app/seksjon/dokumentasjon/locales/{languageTag}.json",
      "#Oppsummering": "./app/seksjon/oppsummering/locales/{languageTag}.json",
      "#Kvittering": "./app/seksjon/kvittering/locales/{languageTag}.json",
      "#Ettersending": "./app/seksjon/ettersending/locales/{languageTag}.json"
    },
    "variableReferencePattern": ["{{", "}}"]
  }
}
