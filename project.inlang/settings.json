{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "nb",
  "locales": ["nb", "en", "nn"],
  "sourceLanguageTag": "nb",
  "languageTags": ["nb", "en", "nn"],
  "modules": [
    "https://cdn.jsdelivr.net/npm/@inlang/plugin-i18next@latest/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/message-lint-rule-missing-translation@latest/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/message-lint-rule-empty-pattern@latest/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/message-lint-rule-without-source@latest/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/message-lint-rule-identical-pattern@latest/dist/index.js"
  ],
  "plugin.inlang.i18next": {
    "pathPattern": {
      "Søknadoversikt ": "./app/seksjon/oversikt/tekst/{languageTag}.json",
      "Personalia ": "./app/seksjon/personalia/v1/tekst/{languageTag}.json",
      "Din situasjon ": "./app/seksjon/din-situasjon/v2/tekst/{languageTag}.json",
      "Arbeidsforhold ": "./app/seksjon/arbeidsforhold/v1/tekst/{languageTag}.json",
      "Reell arbeidssøker ": "./app/seksjon/reell-arbeidssøker/v1/tekst/{languageTag}.json",
      "Utdanning ": "./app/seksjon/utdanning/v1/tekst/{languageTag}.json",
      "Verneplikt ": "./app/seksjon/verneplikt/v1/tekst/{languageTag}.json",
      "Egen næring ": "./app/seksjon/egen-næring/v1/tekst/{languageTag}.json",
      "Annen pengestøtte ": "./app/seksjon/annen-pengestøtte/v1/tekst/{languageTag}.json",
      "Barnetillegg ": "./app/seksjon/barnetillegg/v1/tekst/{languageTag}.json",
      "Dokumentasjon ": "./app/seksjon/dokumentasjon/v1/tekst/{languageTag}.json",
      "Tilleggsopplysninger ": "./app/seksjon/tilleggsopplysninger/v1/tekst/{languageTag}.json",
      "Oppsummering ": "./app/seksjon/oppsummering/tekst/{languageTag}.json",
      "Kvittering ": "./app/seksjon/kvittering/tekst/{languageTag}.json",
      "Ettersending ": "./app/seksjon/ettersending/tekst/{languageTag}.json",
      "Common ": "./app/seksjon/common/tekst/{languageTag}.json"
    },
    "variableReferencePattern": ["{{", "}}"]
  },
  "messageLintRuleLevels": {
    "messageLintRule.inlang.missingTranslation": "error",
    "messageLintRule.inlang.emptyPattern": "error",
    "messageLintRule.inlang.messageWithoutSource": "warning",
    "messageLintRule.inlang.identicalPattern": "warning"
  }
}
