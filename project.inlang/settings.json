{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "nb",
  "locales": ["nb", "en", "nn"],
  "modules": ["https://cdn.jsdelivr.net/npm/@inlang/plugin-i18next@6.5.3/dist/index.js"],
  "plugin.inlang.i18next": {
    "pathPattern": {
      "#Felles": "./app/i18n/locales/{locale}.json",
      "#Oversikt": "./app/seksjon/oversikt/locales/{locale}.json",
      "#Arbeidssøker": "./app/seksjon/arbeidssøker/locales/{locale}.json",
      "#Opprett søknad": "./app/seksjon/opprett-søknad/locales/{locale}.json",
      "#Personalia": "./app/seksjon/personalia/v1/locales/{locale}.json",
      "#Din situasjon": "./app/seksjon/din-situasjon/v1/locales/{locale}.json",
      "#Arbeidsforhold": "./app/seksjon/arbeidsforhold/v2/locales/{locale}.json",
      "#Annen pengestøtte": "./app/seksjon/annen-pengestøtte/v1/locales/{locale}.json",
      "#Egen næring": "./app/seksjon/egen-næring/v1/locales/{locale}.json",
      "#Verneplikt": "./app/seksjon/verneplikt/v1/locales/{locale}.json",
      "#Utdanning": "./app/seksjon/utdanning/v1/locales/{locale}.json",
      "#Barnetillegg": "./app/seksjon/barnetillegg/v1/locales/{locale}.json",
      "#Reell arbeidssøker": "./app/seksjon/reell-arbeidssøker/v1/locales/{locale}.json",
      "#Tilleggsopplysninger": "./app/seksjon/tilleggsopplysninger/v1/locales/{locale}.json",
      "#Dokumentasjon": "./app/seksjon/dokumentasjon/locales/{locale}.json",
      "#Oppsummering": "./app/seksjon/oppsummering/locales/{locale}.json",
      "#Kvittering": "./app/seksjon/kvittering/locales/{locale}.json",
      "#Ettersending": "./app/seksjon/ettersending/locales/{locale}.json"
    },
    "variableReferencePattern": ["{{", "}}"]
  }
}
